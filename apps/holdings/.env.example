# Public base URL, used for canonical URLs, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://arismile.ng

# Optional. When set, /api/contact forwards validated contact-form submissions
# as JSON (POST) to this URL (e.g. a Formspree, Make, Zapier or internal CRM
# webhook). When unset, the form tells visitors to email or call instead and
# never pretends a message was sent.
CONTACT_WEBHOOK_URL=
