# Public base URL of this subsidiary site (canonical URLs, Open Graph).
NEXT_PUBLIC_SITE_URL=https://oceanialtd.com

# Where "Arismile Holdings" links point.
NEXT_PUBLIC_HOLDINGS_URL=https://arismile.ng

# Optional. When set, /api/contact forwards validated contact-form submissions
# as JSON (POST) to this URL. When unset, the form offers a pre-filled email
# instead and never claims a message was sent.
CONTACT_WEBHOOK_URL=
